//3. Nota final del alumno
//Un alumno tiene una nota de 85 en el examen final. 
//Si la nota es 80 o mayor, aprueba la materia. 
//Si es menor a 80, desaprueba. Muestra el resultado.
Algoritmo Nota_final_alumno
	Definir nota Como Entero
	nota = 0
	Escribir "Ingrese nota"
	Leer nota
	Si nota >= 80 Entonces
		Escribir "Aprueba la materia"
	SiNo
		Escribir "Desaprueba la materia"
	FinSi

FinAlgoritmo
