Algoritmo Concatenar_apellido_nombre
	
    Definir nombre, apellido Como Cadena
	
    Escribir "Ingrese el nombre de la persona:"
    Leer nombre
	
    Escribir "Ingrese el apellido de la persona:"
    Leer apellido
	
    Escribir "Nombre completo en formato Apellido Nombre:"
    Escribir apellido, " ", nombre
	
FinAlgoritmo